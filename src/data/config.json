{
  "_comment": "鼠标的偶像梦模拟器 · 全局数值配置。改这里就能调难度，不用碰代码。",

  "economy": {
    "startMoney": 250000,
    "salaryPerIdol": 4200,
    "operationBase": 16000,
    "phase2CostMul": 1.18,
    "raiseMul": 1.2,
    "scaleCost": {
      "_comment": "规模成本：粉丝超过 freeFans 之后，每多一个粉丝每月多花 perFan。摊子大了，人、棚、带宽、法务都要钱。",
      "freeFans": 40000,
      "perFan": 0.75
    }
  },

  "revenue": {
    "_comment": "平台先抽平台抽成，剩下的里面公会抽 guildCut，其余给主播。周边与外快不被抽成。",
    "platformCut": 0.5,
    "guildCutDefault": 0.3,
    "guildCutMin": 0.1,
    "guildCutMax": 0.5,
    "guildCutStep": 0.01,
    "guildCut": {
      "_comment": "成员记住的是长期分成，不是这个月的数字。抽成低于公平线只小幅缓和，高于公平线会明显记仇。",
      "fair": 0.3,
      "aboveSensitivity": 60,
      "belowSensitivity": 20,
      "aboveCapSensitivity": 400,
      "belowCapSensitivity": 0,
      "growthPenalty": 1.4,
      "reputationPenalty": 28,
      "adaptSpeed": 0.4,
      "changeThreshold": 0.05,
      "changePenalty": 2
    },
    "grossPerFan": 8.2,
    "dilution": {
      "_comment": "路人粉不付费：粉丝越多，单个粉丝的月均打赏越低。floor 是稀释的下限，halfFans 是稀释到一半时的大致体量。",
      "halfFans": 150000,
      "floor": 0.35
    },
    "merchPerFan": 0.26,
    "merchCap": 60000,
    "merch": {
      "_comment": "周边制作：开一批要钱（打样、开模、仓储），开完之后每月的周边收入上升；有批数上限。",
      "stepPerLevel": 0.3,
      "capPerLevel": 0.5,
      "maxLevel": 3
    },
    "repBase": 0.6,
    "repDiv": 125
  },

  "fanGrowth": {
    "fansScale": 40000
  },

  "luck": {
    "_comment": "行动发挥的随机分布：主体是对数正态（sigma 越大越飘），外面再套一层小概率的爆款与翻车。分档阈值决定叙事走哪一档。",
    "bodySigma": 0.28,
    "flopChance": 0.08,
    "flop": [0.32, 0.62],
    "surgeChance": 0.06,
    "surge": [1.65, 2.6],
    "bodyClamp": [0.45, 2.2],
    "tiers": { "crit": 1.55, "good": 1.12, "ok": 0.74 }
  },

  "trend": {
    "_comment": "每月平台风向：一个内容方向被推，一个被压。由 seed + 月份直接派生，不写存档，所以读档也不会变。",
    "hotMul": 1.35,
    "coldMul": 0.78,
    "pool": ["chat", "cover", "dance", "variety", "group"],
    "hotLabel": "这阵子平台在推",
    "coldLabel": "算法这阵子不给量"
  },

  "actionPoints": {
    "perMonth": 5,
    "sickPenalty": 4
  },

  "fatigue": {
    "max": 100,
    "sickAt": 100,
    "monthlyRecover": 5
  },

  "morale": {
    "_comment": "按月结算：疲劳落在哪个区间就加减多少心态；再叠加增长、阶段、螺旋、抽成的影响。",
    "bands": [
      { "below": 30, "delta": 3 },
      { "below": 50, "delta": 1.5 },
      { "below": 70, "delta": -1 },
      { "below": 88, "delta": -4 },
      { "below": 999, "delta": -8 }
