    "stagnation": { "threshold": 0.02, "value": -1 },
    "phase2Penalty": -0.3,
    "spiral": { "below": 18, "value": -1.5 },
    "diminishingDivisor": 110,
    "reputationDecay": 0.6
  },

  "graduation": {
    "riskMonths": 3,
    "resetAbove": 25,
    "warnBelow": 28
  },

  "live": {
    "_comment": "线上演唱会的最终结算。venueCost 是虚拟舞台 / 推流 / 导播的制作费，attendance 是直播间峰值在线人数。",
    "venueCost": 250000,
    "attendance": { "base": 1200, "perFan": 0.06, "max": 60000, "venueMul": 2 },
    "weights": {
      "fans": { "max": 30, "base": 5000, "span": 600 },
