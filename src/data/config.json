      { "min": 78, "key": "perfect", "label": "灯牌铺满" },
      { "min": 62, "key": "great", "label": "满月" },
      { "min": 46, "key": "ok", "label": "半场灯" },
      { "min": 0, "key": "poor", "label": "只亮了一排" }
    ]
  },

  "events": {
    "chancePerMonth": 0.82
  },

